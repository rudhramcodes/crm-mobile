{
  "cli": {
    "version": ">= 27.10.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://rudhramgroup.com/api",
        "EXPO_PUBLIC_SOCKET_URL": "https://rudhramgroup.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://rudhramgroup.com/api",
        "EXPO_PUBLIC_SOCKET_URL": "https://rudhramgroup.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
